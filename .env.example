#############################################
# Exemplo de variáveis de ambiente (root)
#
# Observação: Removemos credenciais reais e
# adicionamos placeholders seguros.
#############################################

# ===== Frontend (Next.js) =====
# URL base do backend consumido pelo frontend
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
# Alternativa suportada pelo código
# NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# ===== Testes / Playwright =====
PLAYWRIGHT_BASE_URL=http://localhost:3000
E2E_BASE_URL=http://localhost:3000

# ===== Prisma (opcional no Next) =====
# Caso use Prisma em rotas/server actions no Next,
# defina a URL do banco aqui. Caso contrário,
# prefira definir no backend/.env
# DATABASE_URL=mysql://USER:PASS@HOST:3306/DBNAME

# ===== Ambiente =====
NODE_ENV=development